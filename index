async function loadBrands() {
  const grid = document.getElementById('exploreGrid');
  grid.innerHTML = `<div class="loading">Cargando marcas...</div>`;

  try {
    const q = query(collection(db, "brands"), orderBy("createdAt", "desc"));
    const snapshot = await getDocs(q);

    if (snapshot.empty) {
      grid.innerHTML = `<div class="empty-state">No hay marcas registradas todavía.</div>`;
      return;
    }

    grid.innerHTML = "";
    snapshot.forEach(docSnap => {
      const b = docSnap.data();
      const card = document.createElement('div');
      card.className = 'explore-card';
      const colors = ['#e8431a', '#f2a649', '#185fa5', '#6b2fa0', '#2d6a4f'];
      const randomColor = colors[Math.floor(Math.random() * colors.length)];

      card.innerHTML = `
        <div class="explore-cover" style="background:linear-gradient(45deg, var(--surface2), #000)">🛍️ Lokkal Brand</div>
        <div class="explore-body">
          <div class="explore-avatar" style="background:${randomColor}">${b.name[0].toUpperCase()}</div>
          <div class="explore-name">${b.name}</div>
          <div class="explore-cat">${b.category} • 📍 ${b.city}</div>
          <p class="explore-desc">${b.description || 'Sin descripción disponible.'}</p>
          ${b.website ? `<a class="explore-web" href="${b.website}" target="_blank">Visitar sitio web →</a>` : ''}
        </div>
      `;
      grid.appendChild(card);
    });
  } catch (error) {
    console.error(error);
    grid.innerHTML = `<div class="empty-state">Error al cargar marcas comerciales.</div>`;
  }
}

// --- UTILIDADES ---
function showToast(message) {
  const toast = document.getElementById('toast');
  if (toast) {
    toast.textContent = message;
    toast.classList.add('show');
    setTimeout(() => {
      toast.classList.remove('show');
    }, 3000);
  }
}

