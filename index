<div class="toast" id="toast"></div>
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getFirestore, collection, addDoc, getDocs, query, orderBy, serverTimestamp, setDoc, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
import { getAuth, signInWithPopup, GoogleAuthProvider, createUserWithEmailAndPassword, signInWithEmailAndPassword, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

// Configuración de Firebase
const firebaseConfig = {
  apiKey: "AIzaSyB6SWo8awRffc0NHH1Dn7iM8NCHaMgSTbk",
  authDomain: "lokkal-a04e2.firebaseapp.com",
  projectId: "lokkal-a04e2",
  storageBucket: "lokkal-a04e2.firebasestorage.app",
  messagingSenderId: "338965902047",
  appId: "1:338965902047:web:8e162f48f47cbe92f25b29",
  measurementId: "G-6EXS23SXZT"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);
const auth = getAuth(app);

// Variables de Estado Globales
window._currentUser = null;
let selectedRole = "buyer";
let selectedColors = [];
let selectedSizes = [];
let currentUploadedMediaUrl = "";

// --- NAVEGACIÓN DE LA INTERFAZ ---
window.showView = function(viewId) {
  document.querySelectorAll('.view').forEach(v => v.style.display = 'none');
  const targetView = document.getElementById(`view-${viewId}`);
  if (targetView) targetView.style.display = viewId === 'login' ? 'flex' : 'block';

  document.querySelectorAll('.nav-tab, .bottom-tab').forEach(tab => {
    if (tab.getAttribute('data-view') === viewId || tab.getAttribute('onclick')?.includes(`'${viewId}'`)) {
      tab.classList.add('active');
    } else {
      tab.classList.remove('active');
    }
  });

  if (viewId === 'feed') loadFeed();
  if (viewId === 'explore') loadBrands();
  if (viewId === 'profile') loadProfile();
};

window.showTab = function(tabType) {
  const panelLogin = document.getElementById('panel-login');
  const panelRegister = document.getElementById('panel-register');
  const tabs = document.querySelectorAll('.auth-tab');

  if (tabType === 'login') {
    panelLogin.style.display = 'block';
    panelRegister.style.display = 'none';
    tabs[0].classList.add('active');
    tabs[1].classList.remove('active');
  } else {
    panelLogin.style.display = 'none';
    panelRegister.style.display = 'block';
    tabs[0].classList.remove('active');
    tabs[1].classList.add('active');
  }
};

// --- CONTROL DINÁMICO DE ROLES ---
window.selectRole = function(role) {
  selectedRole = role;
  const btnBuyer = document.getElementById('role-buyer');
  const btnSeller = document.getElementById('role-seller');

  if (role === 'buyer') {
    btnBuyer.classList.add('selected');
    btnSeller.classList.remove('selected');
  } else {
    btnSeller.classList.add('selected');
    btnBuyer.classList.remove('selected');
  }
};

// --- ESCUCHADOR DE ESTADO DE AUTENTICACIÓN (ONAUTHSTATECHANGED) + CONTROL UX ---
onAuthStateChanged(auth, async (user) => {
  const navAuth = document.getElementById('navAuth');
  const navUser = document.getElementById('navUser');
  const topPublishBtn = document.getElementById('topPublishBtn');
  const bottomPublishBtn = document.getElementById('bottomPublishBtn');
  const exploreBrandBtn = document.getElementById('exploreBrandBtn');

  if (user) {
    window._currentUser = user;
    navAuth.style.display = 'none';
    navUser.style.display = 'flex';
    const initial = user.email ? user.email[0].toUpperCase() : '?';
    document.getElementById('navAvatar').textContent = initial;

    try {
      // Consulta en tiempo real del rol almacenado en Firestore
      const userDocRef = doc(db, "users", user.uid);
      const userDocSnap = await getDoc(userDocRef);

      if (userDocSnap.exists()) {
        const userData = userDocSnap.data();
        if (userData.role === 'seller') {
          // Mostrar elementos exclusivos para marcas/vendedores
          if (topPublishBtn) topPublishBtn.style.display = 'block';
          if (bottomPublishBtn) bottomPublishBtn.style.display = 'flex';
          if (exploreBrandBtn) exploreBrandBtn.style.display = 'block';
        } else {
          // Ocultar elementos si es comprador (buyer)
          if (topPublishBtn) topPublishBtn.style.display = 'none';
          if (bottomPublishBtn) bottomPublishBtn.style.display = 'none';
          if (exploreBrandBtn) exploreBrandBtn.style.display = 'none';
        }
      } else {
        // En caso de que el documento no exista aún en base de datos
        if (topPublishBtn) topPublishBtn.style.display = 'none';
        if (bottomPublishBtn) bottomPublishBtn.style.display = 'none';
        if (exploreBrandBtn) exploreBrandBtn.style.display = 'none';
      }
    } catch (error) {
      console.error("Error al recuperar el rol del usuario de Firestore:", error);
    }
  } else {
    window._currentUser = null;
    navAuth.style.display = 'flex';
    navUser.style.display = 'none';
    
    // Ocultar herramientas de publicación por defecto sin sesión activa
    if (topPublishBtn) topPublishBtn.style.display = 'none';
    if (bottomPublishBtn) bottomPublishBtn.style.display = 'none';
    if (exploreBrandBtn) exploreBrandBtn.style.display = 'none';
  }
});

// --- AUTENTICACIÓN Y FLUJO UNIFICADO DE ROLES ---
window.registerEmail = async function() {
  const email = document.getElementById('regEmail').value.trim();
  const pass = document.getElementById('regPass').value.trim();
  const btn = document.getElementById('btnRegister');

  if (!email || !pass) {
    showToast("Por favor completa todos los campos");
    return;
  }
  if (pass.length < 6) {
    showToast("La contraseña debe tener mínimo 6 caracteres");
    return;
  }

  btn.disabled = true;
  btn.textContent = "Creando cuenta...";

  try {
    const userCredential = await createUserWithEmailAndPassword(auth, email, pass);
    const user = userCredential.user;

    // Persistir rol dinámico seleccionado en Firestore
    await setDoc(doc(db, "users", user.uid), {
      email: user.email,
      role: selectedRole,
      createdAt: serverTimestamp()
    });

    showToast("¡Cuenta creada con éxito!");
    
    if (selectedRole === 'seller') {
      window.showView('explore');
      window.openBrandModal();
    } else {
      window.showView('feed');
    }
  } catch (error) {
    console.error(error);
    showToast("Error al registrarse: " + error.message);
  } finally {
    btn.disabled = false;
    btn.textContent = "Crear cuenta";
  }
};

window.loginEmail = async function() {
  const email = document.getElementById('loginEmail').value.trim();
  const pass = document.getElementById('loginPass').value.trim();

  if (!email || !pass) {
    showToast("Ingresa correo y contraseña");
    return;
  }

  try {
    await signInWithEmailAndPassword(auth, email, pass);
    showToast("¡Bienvenido de nuevo!");
    window.showView('feed');
  } catch (error) {
    console.error(error);
    showToast("Credenciales incorrectas");
  }
};

window.loginGoogle = async function() {
  const provider = new GoogleAuthProvider();
  try {
    const result = await signInWithPopup(auth, provider);
    const user = result.user;

    // Verificar si el usuario ya tiene un rol guardado previamente para no sobreescribirlo
    const userDocRef = doc(db, "users", user.uid);
    const userDocSnap = await getDoc(userDocRef);

    let roleToAssign = selectedRole;

    if (userDocSnap.exists()) {
      roleToAssign = userDocSnap.data().role || selectedRole;
      await setDoc(userDocRef, { email: user.email }, { merge: true });
    } else {
      // Registrar por primera vez respetando el rol activo en la interfaz
      await setDoc(userDocRef, {
        email: user.email,
        role: roleToAssign,
        createdAt: serverTimestamp()
      });
    }

    showToast("Sesión iniciada con Google");

    if (roleToAssign === 'seller') {
      window.showView('explore');
      window.openBrandModal();
    } else {
      window.showView('feed');
    }
  } catch (error) {
    console.error(error);
    showToast("Error en login con Google");
  }
};

window.logout = async function() {
  try {
    await signOut(auth);
    showToast("Sesión cerrada");
    window.showView('feed');
  } catch (error) {
    console.error(error);
  }
};

// --- PERFIL DE USUARIO ---
function loadProfile() {
  if (!window._currentUser) return;
  const u = window._currentUser;
  const initial = u.email ? u.email[0].toUpperCase() : '?';
  document.getElementById('profileAv').textContent = initial;
  document.getElementById('profileName').textContent = u.displayName || 'Usuario de Lokkal';
  document.getElementById('profileEmail').textContent = u.email;
}

// --- INTERACCIONES DE FORMULARIOS Y ATRIBUTOS ---
window.openPublish = function() {
  if (!window._currentUser) {
    showToast("Inicia sesión para publicar");
    window.showView('login');
    return;
  }
  document.getElementById('modalPublish').style.display = 'flex';
};

window.closePublish = function() {
  document.getElementById('modalPublish').style.display = 'none';
  document.getElementById('publishForm').reset();
  document.getElementById('mediaPreview').innerHTML = "";
  selectedColors = [];
  selectedSizes = [];
  currentUploadedMediaUrl = "";
  document.querySelectorAll('.color-btn, .size-btn').forEach(b => b.classList.remove('selected'));
};

window.openBrandModal = function() {
  if (!window._currentUser) {
    showToast("Inicia sesión primero");
    window.showView('login');
    return;
  }
  document.getElementById('modalBrand').style.display = 'flex';
};

window.closeBrandModal = function() {
  document.getElementById('modalBrand').style.display = 'none';
};

window.toggleColor = function(color, element) {
  const index = selectedColors.indexOf(color);
  if (index > -1) {
    selectedColors.splice(index, 1);
    element.classList.remove('selected');
  } else {
    selectedColors.push(color);
    element.classList.add('selected');
  }
};

window.toggleSize = function(size, element) {
  const index = selectedSizes.indexOf(size);
  if (index > -1) {
    selectedSizes.splice(index, 1);
    element.classList.remove('selected');
  } else {
    selectedSizes.push(size);
    element.classList.add('selected');
  }
};

// --- PROCESAMIENTO MULTIMEDIA (CLOUDINARY) ---
window.previewMedia = async function(input) {
  const file = input.files[0];
  if (!file) return;

  const previewContainer = document.getElementById('mediaPreview');
  previewContainer.innerHTML = `<div class="loading" style="padding:1rem;">Procesando archivo...</div>`;

  const cloudName = "lokkal"; 
  const uploadPreset = "ml_default"; 

  const formData = new FormData();
  formData.append("file", file);
  formData.append("upload_preset", uploadPreset);

  try {
    const res = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/upload`, {
      method: "POST",
      body: formData
    });
    const data = await res.json();
    
    if (data.secure_url) {
      currentUploadedMediaUrl = data.secure_url;
      if (file.type.startsWith('video/')) {
        previewContainer.innerHTML = `<video src="${currentUploadedMediaUrl}" style="width:100%; max-height:150px; object-fit:cover; border-radius:8px;" autoplay muted loop></video>`;
      } else {
        previewContainer.innerHTML = `<img src="${currentUploadedMediaUrl}" style="width:100%; max-height:150px; object-fit:cover; border-radius:8px;">`;
      }
      showToast("Multimedia procesada correctamente");
    } else {
      throw new Error("Error en respuesta de almacenamiento remoto");
    }
  } catch (err) {
    console.error(err);
    previewContainer.innerHTML = `<div style="color:red; font-size:0.8rem; padding:0.5rem;">Error al procesar archivo técnico</div>`;
  }
};

// --- PERSISTENCIA EN CLOUD FIRESTORE ---
window.submitProduct = async function() {
  const name = document.getElementById('prodName').value.trim();
  const price = document.getElementById('prodPrice').value.trim();
  const brand = document.getElementById('prodBrand').value.trim();
  const city = document.getElementById('prodCity').value.trim();
  const whatsapp = document.getElementById('prodWhatsapp').value.trim();
  const url = document.getElementById('prodBrandUrl').value.trim();
  const desc = document.getElementById('prodDesc').value.trim();
  const btn = document.getElementById('btnPublish');

  if (!name || !price || !brand || !whatsapp || !currentUploadedMediaUrl) {
    showToast("Por favor completa los campos obligatorios y sube un archivo");
    return;
  }

  btn.disabled = true;
  btn.textContent = "Publicando... 🚀";

  try {
    await addDoc(collection(db, "products"), {
      name,
      price: Number(price),
      brandName: brand,
      city: city || "Colombia",
      whatsapp,
      website: url || "",
      colors: selectedColors,
      sizes: selectedSizes,
      description: desc,
      mediaUrl: currentUploadedMediaUrl,
      userId: window._currentUser.uid,
      createdAt: serverTimestamp()
    });

    showToast("¡Producto publicado exitosamente!");
    window.closePublish();
    loadFeed();
  } catch (error) {
    console.error(error);
    showToast("Error al guardar producto");
  } finally {
    btn.disabled = false;
    btn.textContent = "Publicar producto 🚀";
  }
};

window.submitBrand = async function() {
  const name = document.getElementById('brandName').value.trim();
  const cat = document.getElementById('brandCat').value;
  const city = document.getElementById('brandCity').value.trim();
  const whatsapp = document.getElementById('brandWhatsapp').value.trim();
  const web = document.getElementById('brandWebsite').value.trim();
  const desc = document.getElementById('brandDesc').value.trim();

  if (!name || !city || !whatsapp) {
    showToast("Completa los campos obligatorios");
    return;
  }

  try {
    await addDoc(collection(db, "brands"), {
      name,
      category: cat,
      city,
      whatsapp,
      website: web || "",
      description: desc,
      userId: window._currentUser.uid,
      createdAt: serverTimestamp()
    });

    showToast("¡Marca registrada con éxito!");
    window.closeBrandModal();
    if (document.getElementById('view-explore').style.display === 'block') {
      loadBrands();
    }
  } catch (error) {
    console.error(error);
    showToast("Error al guardar marca");
  }
};

