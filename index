<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lokkal — Marcas Colombianas</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Instrument+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0a0a0a;
  --surface: #111;
  --surface2: #1a1a1a;
  --accent: #e8431a;
  --accent2: #f2a649;
  --text: #f5f0e8;
  --muted: #888;
  --border: rgba(255,255,255,0.08);
  --radius: 16px;
  --font: 'Syne', sans-serif;
  --body: 'Instrument Sans', sans-serif;
}
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}
html, body {
  height: 100%;
  overflow: hidden;
}
body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--body);
}

/* NAV */
nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.8rem 1.2rem;
  background: rgba(10,10,10,0.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}
.nav-logo {
  font-family: var(--font);
  font-size: 1.3rem;
  font-weight: 800;
  color: var(--text);
  letter-spacing: -0.02em;
  cursor: pointer;
}
.nav-logo span {
  color: var(--accent);
}
.nav-tabs {
  display: flex;
  gap: 4px;
}
.nav-tab {
  background: none;
  border: none;
  color: var(--muted);
  font-family: var(--font);
  font-size: 0.8rem;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: 50px;
  cursor: pointer;
  transition: all 0.2s;
}
.nav-tab.active, .nav-tab:hover {
  background: var(--surface2);
  color: var(--text);
}
.nav-right {
  display: flex;
  align-items: center;
  gap: 8px;
}
#navAuth {
  display: flex;
  gap: 6px;
}
#navUser {
  display: none;
  align-items: center;
  gap: 10px;
}
.nav-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font);
  font-size: 0.85rem;
  font-weight: 700;
  cursor: pointer;
}
.btn-nav {
  background: var(--accent);
  color: white;
  border: none;
  border-radius: 50px;
  padding: 7px 16px;
  font-family: var(--font);
  font-size: 0.8rem;
  font-weight: 700;
  cursor: pointer;
  transition: opacity 0.2s;
}
.btn-nav:hover {
  opacity: 0.85;
}
.btn-nav.ghost {
  background: var(--surface2);
  color: var(--text);
}
.btn-publish {
  background: var(--accent2);
  color: #0a0a0a;
  border: none;
  border-radius: 50px;
  padding: 7px 14px;
  font-family: var(--font);
  font-size: 0.8rem;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 5px;
}

/* CLASES DE CONTROL DINÁMICO POR ROL */
.seller-only {
  display: none !important;
}

/* MAIN */
.main {
  height: 100vh;
  padding-top: 56px;
  overflow: hidden;
}
.view {
  height: 100%;
  display: none;
}
#view-feed {
  display: block;
}

/* FEED */
.feed-container {
  height: 100%;
  overflow-y: scroll;
  scroll-snap-type: y mandatory;
  scroll-behavior: smooth;
}
.feed-container::-webkit-scrollbar {
  display: none;
}
.feed-card {
  height: 100%;
  scroll-snap-align: start;
  position: relative;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.feed-media {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
}
.feed-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 50%, rgba(0,0,0,0.3) 100%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 1rem;
}
.feed-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 0.5rem;
}
.feed-avatar {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font);
  font-size: 1rem;
  font-weight: 700;
  flex-shrink: 0;
  border: 2px solid white;
}
.feed-brand-name {
  font-family: var(--font);
  font-size: 0.9rem;
  font-weight: 700;
}
.feed-brand-city {
  font-size: 0.72rem;
  color: rgba(255,255,255,0.6);
}
.feed-web-btn {
  margin-left: auto;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255,255,255,0.2);
  color: white;
  border-radius: 50px;
  padding: 5px 12px;
  font-size: 0.75rem;
  text-decoration: none;
  font-family: var(--font);
  font-weight: 600;
}
.feed-info {
  margin-top: auto;
}
.feed-product-name {
  font-family: var(--font);
  font-size: 1.2rem;
  font-weight: 700;
  margin-bottom: 4px;
}
.feed-price {
  font-family: var(--font);
  font-size: 1.4rem;
  font-weight: 800;
  color: var(--accent2);
  margin-bottom: 8px;
}
.feed-colors {
  display: flex;
  gap: 6px;
  margin-bottom: 8px;
}
.color-dot {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 2px solid white;
  flex-shrink: 0;
}
.feed-sizes {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 8px;
}
.size-tag {
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255,255,255,0.3);
  color: white;
  border-radius: 6px;
  padding: 3px 10px;
  font-size: 0.75rem;
  font-family: var(--font);
  font-weight: 600;
}
.feed-desc {
  font-size: 0.83rem;
  color: rgba(255,255,255,0.75);
  margin-bottom: 12px;
  line-height: 1.4;
}
.feed-whatsapp {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #25d366;
  color: white;
  border: none;
  border-radius: 50px;
  padding: 11px 22px;
  font-family: var(--font);
  font-size: 0.88rem;
  font-weight: 700;
  cursor: pointer;
  text-decoration: none;
  transition: opacity 0.2s;
}
.feed-whatsapp:hover {
  opacity: 0.9;
}

/* EXPLORE */
#view-explore {
  overflow-y: auto;
  padding: 1rem;
}
.explore-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.2rem;
}
.explore-title {
  font-family: var(--font);
  font-size: 1.3rem;
  font-weight: 700;
}
.btn-add-brand {
  background: var(--accent);
  color: white;
  border: none;
  border-radius: 50px;
  padding: 8px 16px;
  font-family: var(--font);
  font-size: 0.8rem;
  font-weight: 700;
  cursor: pointer;
}
.explore-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 1rem;
}
.explore-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  transition: transform 0.2s;
}
.explore-card:hover {
  transform: translateY(-3px);
}
.explore-cover {
  height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.explore-body {
  padding: 1rem;
}
.explore-avatar {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font);
  font-size: 1.1rem;
  font-weight: 700;
  color: white;
  margin-bottom: 8px;
  margin-top: -28px;
  border: 3px solid var(--surface);
}
.explore-name {
  font-family: var(--font);
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 2px;
}
.explore-cat {
  font-size: 0.75rem;
  color: var(--muted);
  margin-bottom: 8px;
}
.explore-desc {
  font-size: 0.82rem;
  color: rgba(245,240,232,0.6);
  margin-bottom: 10px;
  line-height: 1.5;
}
.explore-web {
  display: inline-block;
  font-size: 0.8rem;
  color: var(--accent2);
  text-decoration: none;
}

/* LOGIN VIEW */
#view-login {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow-y: auto;
}
.auth-box {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 2rem;
  width: 100%;
  max-width: 380px;
  margin: 1rem;
}
.auth-logo {
  font-family: var(--font);
  font-size: 1.8rem;
  font-weight: 800;
  text-align: center;
  margin-bottom: 0.3rem;
}
.auth-logo span {
  color: var(--accent);
}
.auth-sub {
  text-align: center;
  color: var(--muted);
  font-size: 0.85rem;
  margin-bottom: 1.5rem;
}
.auth-tabs {
  display: flex;
  background: var(--surface2);
  border-radius: 50px;
  padding: 3px;
  margin-bottom: 1.5rem;
}
.auth-tab {
  flex: 1;
  background: none;
  border: none;
  color: var(--muted);
  font-family: var(--font);
  font-size: 0.82rem;
  font-weight: 600;
  padding: 7px;
  border-radius: 50px;
  cursor: pointer;
  transition: all 0.2s;
}
.auth-tab.active {
  background: var(--surface);
  color: var(--text);
}
.btn-google {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: white;
  color: #333;
  border: none;
  border-radius: 50px;
  padding: 11px;
  font-family: var(--font);
  font-size: 0.88rem;
  font-weight: 600;
  cursor: pointer;
  margin-bottom: 1rem;
  transition: opacity 0.2s;
}
.btn-google:hover {
  opacity: 0.9;
}
.divider {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 1rem;
  color: var(--muted);
  font-size: 0.78rem;
}
.divider::before, .divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
}

/* INTERFAZ SELECCIÓN DE ROLES */
.role-selector {
  display: flex;
  gap: 10px;
  margin-bottom: 1.2rem;
}
.role-btn {
  flex: 1;
  background: var(--surface2);
  border: 1.5px solid var(--border);
  color: var(--muted);
  border-radius: 10px;
  padding: 12px 8px;
  font-family: var(--font);
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  transition: all 0.2s ease;
}
.role-btn.selected {
  border-color: var(--accent);
  background: rgba(232, 67, 26, 0.05);
  color: var(--text);
}
.role-btn span {
  font-size: 1.2rem;
}

/* PROFILE VIEW */
#view-profile {
  overflow-y: auto;
  padding: 1rem;
}
.profile-header {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.5rem;
  margin-bottom: 1rem;
  text-align: center;
}
.profile-av {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font);
  font-size: 1.8rem;
  font-weight: 700;
  margin: 0 auto 0.8rem;
}
.profile-name {
  font-family: var(--font);
  font-size: 1.1rem;
  font-weight: 700;
}
.profile-email {
  font-size: 0.82rem;
  color: var(--muted);
}
.btn-logout {
  background: var(--surface2);
  color: var(--muted);
  border: 1px solid var(--border);
  border-radius: 50px;
  padding: 7px 16px;
  font-family: var(--font);
  font-size: 0.8rem;
  cursor: pointer;
  margin-top: 1rem;
}

/* FORMS */
.form-group {
  margin-bottom: 0.9rem;
}
.form-label {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--muted);
  margin-bottom: 5px;
  display: block;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.form-input, .form-select, .form-textarea {
  width: 100%;
  padding: 10px 13px;
  border: 1.5px solid var(--border);
  border-radius: 10px;
  font-family: var(--body);
  font-size: 0.88rem;
  background: var(--surface2);
  color: var(--text);
  outline: none;
  transition: border-color 0.2s;
}
.form-input:focus, .form-select:focus, .form-textarea:focus {
  border-color: var(--accent);
}
.form-select option {
  background: var(--surface2);
}
.form-textarea {
  resize: vertical;
  min-height: 70px;
}
.btn-submit {
  width: 100%;
  background: var(--accent);
  color: white;
  border: none;
  border-radius: 50px;
  padding: 13px;
  font-family: var(--font);
  font-size: 0.92rem;
  font-weight: 700;
  cursor: pointer;
  margin-top: 0.5rem;
  transition: opacity 0.2s;
}
.btn-submit:hover {
  opacity: 0.9;
}
.btn-submit:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* COLORS PICKER */
.colors-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.color-btn {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 3px solid transparent;
  cursor: pointer;
  transition: border-color 0.2s;
}
.color-btn.selected {
  border-color: white;
}
.sizes-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.size-btn {
  background: var(--surface2);
  border: 1.5px solid var(--border);
  color: var(--muted);
  border-radius: 8px;
  padding: 5px 12px;
  font-family: var(--font);
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}
.size-btn.selected {
  background: var(--accent);
  border-color: var(--accent);
  color: white;
}

/* MODAL */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.8);
  z-index: 200;
  display: none;
  align-items: flex-end;
  justify-content: center;
  backdrop-filter: blur(4px);
}
@media(min-width: 600px) {
  .modal-overlay { align-items: center; }
}
.modal {
  background: var(--surface);
  border-radius: var(--radius) var(--radius) 0 0;
  padding: 1.5rem;
  width: 100%;
  max-width: 480px;
  max-height: 88vh;
  overflow-y: auto;
  position: relative;
}
@media(min-width: 600px) {
  .modal { border-radius: var(--radius); }
}
.modal-handle {
  width: 40px;
  height: 4px;
  background: var(--border);
  border-radius: 2px;
  margin: 0 auto 1.2rem;
}
.modal-title {
  font-family: var(--font);
  font-size: 1.2rem;
  font-weight: 700;
  margin-bottom: 0.3rem;
}
.modal-sub {
  font-size: 0.82rem;
  color: var(--muted);
  margin-bottom: 1.2rem;
}
.modal-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: var(--surface2);
  border: none;
  border-radius: 50%;
  width: 30px;
  height: 30px;
  cursor: pointer;
  color: var(--muted);
  font-size: 1rem;
}

/* MEDIA UPLOAD */
.upload-area {
  border: 2px dashed var(--border);
  border-radius: 12px;
  padding: 1.5rem;
  text-align: center;
  cursor: pointer;
  transition: border-color 0.2s;
  margin-bottom: 0.5rem;
}
.upload-area:hover {
  border-color: var(--accent);
}
.upload-icon {
  font-size: 1.8rem;
  margin-bottom: 0.5rem;
}
.upload-text {
  font-size: 0.82rem;
  color: var(--muted);
}

/* STATES */
.loading {
  text-align: center;
  padding: 3rem;
  color: var(--muted);
  font-family: var(--font);
}
.empty-state {
  text-align: center;
  padding: 3rem 1rem;
  color: var(--muted);
  font-size: 0.9rem;
  line-height: 2;
}

/* TOAST */
.toast {
  position: fixed;
  bottom: 80px;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: var(--surface2);
  color: var(--text);
  border: 1px solid var(--border);
  padding: 10px 22px;
  border-radius: 50px;
  font-size: 0.83rem;
  font-family: var(--font);
  font-weight: 600;
  z-index: 300;
  transition: all 0.3s;
  opacity: 0;
  pointer-events: none;
  white-space: nowrap;
}
.toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* BOTTOM NAV MOBILE */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(10,10,10,0.95);
  backdrop-filter: blur(12px);
  border-top: 1px solid var(--border);
  display: flex;
  z-index: 100;
}
.bottom-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 10px 0;
  background: none;
  border: none;
  color: var(--muted);
  font-family: var(--font);
  font-size: 0.65rem;
  font-weight: 600;
  cursor: pointer;
  transition: color 0.2s;
}
.bottom-tab.active, .bottom-tab:hover {
  color: var(--text);
}
.bottom-tab svg {
  width: 20px;
  height: 20px;
}
.bottom-tab.publish-tab {
  color: var(--accent2);
}
</style>
</head>
<body>

<nav>
  <span class="nav-logo" onclick="showView('feed')">lokk<span>al</span></span>
  <div class="nav-tabs">
    <button class="nav-tab active" data-view="feed" onclick="showView('feed')">Feed</button>
    <button class="nav-tab" data-view="explore" onclick="showView('explore')">Marcas</button>
  </div>
  <div class="nav-right">
    <div id="navAuth">
      <button class="btn-nav ghost" onclick="showView('login')">Entrar</button>
    </div>
    <div id="navUser">
      <button class="btn-publish seller-only" id="topPublishBtn" onclick="openPublish()">+ Publicar</button>
      <div class="nav-avatar" id="navAvatar" onclick="showView('profile')">?</div>
    </div>
  </div>
</nav>

<div class="main">

  <div id="view-feed" class="view">
    <div class="feed-container" id="feedContainer">
      <div class="loading">Cargando feed...</div>
    </div>
  </div>

  <div id="view-explore" class="view">
    <div class="explore-header">
      <div class="explore-title">Marcas</div>
      <button class="btn-add-brand seller-only" id="exploreBrandBtn" onclick="openBrandModal()">+ Registrar marca</button>
    </div>
    <div class="explore-grid" id="exploreGrid">
      <div class="loading">Cargando...</div>
    </div>
  </div>

  <div id="view-login" class="view">
    <div class="auth-box">
      <div class="auth-logo">lokk<span>al</span></div>
      <div class="auth-sub">Entra para publicar y vender</div>
      
      <label class="form-label">Quiero usar Lokkal para:</label>
      <div class="role-selector">
        <button type="button" class="role-btn selected" id="role-buyer" onclick="selectRole('buyer')">
          <span>🛍️</span>Comprar
        </button>
        <button type="button" class="role-btn" id="role-seller" onclick="selectRole('seller')">
          <span>🏪</span>Tener una Marca
        </button>
      </div>

      <button class="btn-google" onclick="loginGoogle()">
